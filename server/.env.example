PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/lifeline-blood-bank
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Nodemailer SMTP (Gmail App Password, Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Lifeline Blood Bank <your_email@gmail.com>"
